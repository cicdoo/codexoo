<odoo>

    <!-- Default configuration parameters -->
    <record id="param_cli_glob" model="ir.config_parameter">
        <field name="key">codexoo.cli_glob</field>
        <field name="value">/usr/local/bin/codex</field>
    </record>
    <record id="param_home_root" model="ir.config_parameter">
        <field name="key">codexoo.home_root</field>
        <field name="value">/var/lib/odoo/codexoo_home</field>
    </record>
    <record id="param_scratch_root" model="ir.config_parameter">
        <field name="key">codexoo.scratch_root</field>
        <field name="value">/var/lib/odoo/codexoo_scratch</field>
    </record>
    <!-- No codexoo.model seed: empty = use the ChatGPT account's default model.
         (Pinning gpt-5-codex 400s on ChatGPT-subscription auth.) -->
    <record id="param_base_url" model="ir.config_parameter">
        <field name="key">codexoo.base_url</field>
        <field name="value">http://127.0.0.1:8069</field>
    </record>
    <record id="param_sql_enabled" model="ir.config_parameter">
        <field name="key">codexoo.sql_enabled</field>
        <field name="value">True</field>
    </record>

    <!-- Client action that opens the chat UI -->
    <record id="action_ai_chat" model="ir.actions.client">
        <field name="name">Codexoo</field>
        <field name="tag">codexoo.chat</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ai_root" name="Codexoo"
              web_icon="codexoo,static/description/icon.png"
              sequence="20" groups="group_ai_user"/>
    <menuitem id="menu_ai_chat" name="Chat"
              parent="menu_ai_root" action="action_ai_chat"
              sequence="10" groups="group_ai_user"/>

    <!-- Cron: reap stuck running sessions and GC old scratch dirs -->
    <record id="cron_ai_reaper" model="ir.cron">
        <field name="name">Codexoo: reap stale sessions</field>
        <field name="model_id" ref="model_codexoo_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_reap_stale()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
