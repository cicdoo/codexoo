<odoo>

    <record id="view_users_form_ai_oauth" model="ir.ui.view">
        <field name="name">res.users.form.ai.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Codexoo AI Assistant" name="codexoo"
                      groups="codexoo.group_ai_user">
                    <group>
                        <field name="codexoo_oauth_set" readonly="1"/>
                        <button name="action_codexoo_logout" type="object"
                                string="Disconnect ChatGPT account"
                                class="btn-secondary"
                                invisible="not codexoo_oauth_set"
                                confirm="Disconnect this ChatGPT account? The user will need to log in again."/>
                    </group>
                    <div class="text-muted">
                        Each user connects their own ChatGPT subscription from the
                        <b>AI Assistant</b> chat using the <b>Login with ChatGPT</b>
                        button. Credentials are stored privately per user and are
                        never shared.
                    </div>
                    <group string="Tool Permissions"
                           groups="codexoo.group_ai_manager">
                        <field name="codexoo_tool_ids"
                               widget="many2many_tags"
                               placeholder="Empty = all read-only tools"/>
                        <field name="codexoo_zero_trust_mode"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Same status on the simplified "My Preferences" form -->
    <record id="view_users_form_simple_ai_oauth" model="ir.ui.view">
        <field name="name">res.users.preferences.form.ai.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Codexoo AI Assistant" groups="codexoo.group_ai_user">
                    <field name="codexoo_oauth_set" readonly="1"/>
                    <button name="action_codexoo_logout" type="object"
                            string="Disconnect ChatGPT account"
                            class="btn-secondary"
                            invisible="not codexoo_oauth_set"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
